# Base de datos (Turso / libSQL). En local basta con un archivo SQLite.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Better Auth — genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SMTP (en desarrollo puedes usar Mailpit: localhost:1025, sin usuario)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Meraki <no-responder@meraki.local>"

APP_TIMEZONE=America/Mexico_City

# Administrador inicial (pnpm db:seed)
ADMIN_NAME="Administración Meraki"
ADMIN_EMAIL=admin@meraki.local
ADMIN_PASSWORD=

# Grabación de sesiones con IA (opcional: sin estas variables no aparece el botón de grabar)
# Blob privado de Vercel: en Vercel se autentica solo (OIDC + BLOB_STORE_ID);
# en local se obtienen con `vercel env pull .env.local`.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Transcripción (console.groq.com/keys, con Zero Data Retention activado)
GROQ_API_KEY=
# Redacción del SOAP vía Vercel AI Gateway (solo en local; en Vercel usa OIDC)
AI_GATEWAY_API_KEY=
# Protege el cron que borra audios vencidos (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CRON_SECRET=
